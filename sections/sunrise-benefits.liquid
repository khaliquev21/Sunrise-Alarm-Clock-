{%- liquid
  assign background = section.settings.background
-%}
<section
  class="sr-section{% if background == 'warm' %} sr-bg-warm{% endif %}"
  style="--sr-pad-top: {{ section.settings.padding_top }}px; --sr-pad-bottom: {{ section.settings.padding_bottom }}px; --sr-pad-top-mobile: {{ section.settings.padding_top | times: 0.6 | round }}px; --sr-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.6 | round }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="sr-section-head sr-section-head--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sr-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sr-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="sr-lede">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="sr-grid sr-grid--3 list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="sr-card sr-benefit" {{ block.shopify_attributes }}>
          <span class="sr-icon-badge">{% render 'sunrise-icon', icon: block.settings.icon %}</span>
          <h3 class="sr-card-title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="sr-small">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Sunrise benefits",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sun", "label": "Sunrise" },
            { "value": "clock", "label": "Clock" },
            { "value": "cup", "label": "Coffee cup" },
            { "value": "moon", "label": "Moon" },
            { "value": "check", "label": "Check" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "sun"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wake Up With the Sunrise"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "warm", "label": "Warm" },
        { "value": "white", "label": "White" }
      ],
      "default": "warm"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Sunrise benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "sun",
            "title": "Gradual sunrise lighting",
            "text": "A warm amber light that gradually brightens, bringing a sunrise-style glow into your room."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "clock",
            "title": "Modern bedside design",
            "text": "A rounded shape, soft grey fabric and a clean white time display that suits any nightstand."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "cup",
            "title": "A more inviting morning",
            "text": "Trade a dark, sudden start for a warm glow — light first, then the rest of your day."
          }
        }
      ]
    }
  ]
}
{% endschema %}

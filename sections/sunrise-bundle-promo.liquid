{% comment %}
  Two-clock bundle promo. Every price comes from the bundle variant (and the
  single variant for the saving); the section stays hidden on the storefront
  if the bundle variant does not exist, so it never advertises an offer that
  cannot be bought.
{% endcomment %}
{%- liquid
  assign promo_product = section.settings.product
  if promo_product == blank
    assign promo_product = collections.all.products.first
  endif

  assign bundle_variant = nil
  assign single_variant = nil
  if promo_product
    capture bundle_id
      render 'sunrise-find-variant', product: promo_product, value: section.settings.bundle_option_value
    endcapture
    capture single_id
      render 'sunrise-find-variant', product: promo_product, value: section.settings.single_option_value
    endcapture
    assign bundle_num = bundle_id | strip | plus: 0
    assign single_num = single_id | strip | plus: 0
    for v in promo_product.variants
      if v.id == bundle_num
        assign bundle_variant = v
      endif
      if v.id == single_num
        assign single_variant = v
      endif
    endfor
  endif

  if bundle_variant and section.settings.bundle_option_value != blank
    assign units = section.settings.bundle_units
    assign bundle_price = bundle_variant.price | money
    assign per_unit = bundle_variant.price | times: 1.0 | divided_by: units | round | money
    assign compare_price = ''
    if bundle_variant.compare_at_price > bundle_variant.price
      assign compare_price = bundle_variant.compare_at_price | money
    endif
    assign vs_singles = ''
    if single_variant and single_variant.id != bundle_variant.id
      assign vs_singles_amount = single_variant.price | times: units | minus: bundle_variant.price
      if vs_singles_amount > 0
        assign vs_singles = vs_singles_amount | money
      endif
    endif

    assign heading = section.settings.heading | escape | replace: '[bundle_price]', bundle_price | replace: '[per_unit]', per_unit | replace: '[compare_price]', compare_price
    assign text = section.settings.text | escape
    if vs_singles == blank
      assign text = section.settings.text_without_saving | escape
    endif
    assign text = text | replace: '[bundle_price]', bundle_price | replace: '[per_unit]', per_unit | replace: '[savings_vs_singles]', vs_singles | replace: '[compare_price]', compare_price

    assign promo_link = promo_product.url | append: '?variant=' | append: bundle_variant.id
    assign image_1 = section.settings.image_1 | default: promo_product.featured_media.preview_image
    assign image_2 = section.settings.image_2 | default: image_1
  endif
-%}

{%- if bundle_variant and section.settings.bundle_option_value != blank -%}
  <section
    class="sr-section"
    style="--sr-pad-top: {{ section.settings.padding_top }}px; --sr-pad-bottom: {{ section.settings.padding_bottom }}px; --sr-pad-top-mobile: {{ section.settings.padding_top | times: 0.6 | round }}px; --sr-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.6 | round }}px;"
  >
    <div class="page-width">
      <div class="sr-promo">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="sr-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="sr-heading">{{ heading }}</h2>
          {%- if text != blank -%}
            <p class="sr-small sr-promo__text">{{ text }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <div class="sr-promo__cta">
              <a class="sr-btn sr-btn--primary" href="{{ promo_link }}">{{ section.settings.button_label | escape }}</a>
            </div>
          {%- endif -%}
        </div>
        {%- if image_1 != blank -%}
          <div class="sr-promo__images" aria-hidden="true">
            {%- for img in (1..2) -%}
              {%- if forloop.first -%}
                {%- assign promo_image = image_1 -%}
              {%- else -%}
                {%- assign promo_image = image_2 -%}
              {%- endif -%}
              <div class="sr-media">
                {{
                  promo_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 20vw, 45vw', alt: ''
                }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width sr-section">
    <p class="sr-editor-note">
      The bundle promo is hidden on your store: no variant matching "{{ section.settings.bundle_option_value | escape }}"
      was found on {{ promo_product.title | default: 'the selected product' | escape }}. Create the bundle variant in
      Shopify admin or update "Bundle variant option value".
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Sunrise bundle promo",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Prices are read from the bundle variant. The section is hidden on your store if that variant doesn't exist."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Defaults to the first product in your store."
    },
    {
      "type": "text",
      "id": "bundle_option_value",
      "label": "Bundle variant option value",
      "default": "2 Clocks"
    },
    {
      "type": "range",
      "id": "bundle_units",
      "label": "Clocks in the bundle",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "single_option_value",
      "label": "Single variant option value",
      "info": "Used to calculate the saving versus buying singles.",
      "default": "1 Clock"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Better together"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Tokens: [bundle_price], [per_unit], [compare_price].",
      "default": "2 Sunrise Alarm Clocks for [bundle_price]"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Tokens: [bundle_price], [per_unit], [savings_vs_singles], [compare_price].",
      "default": "[per_unit] per clock — [savings_vs_singles] less than buying two separately. One for you, one to gift."
    },
    {
      "type": "textarea",
      "id": "text_without_saving",
      "label": "Text when there is no saving versus singles",
      "default": "[per_unit] per clock. One for you, one to gift."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the bundle"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1",
      "info": "Defaults to the product's featured image."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Sunrise bundle promo"
    }
  ]
}
{% endschema %}

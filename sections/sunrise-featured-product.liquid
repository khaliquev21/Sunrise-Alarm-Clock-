{%- liquid
  assign fp = section.settings.product
  if fp == blank
    assign fp = collections.all.products.first
  endif

  if fp
    capture single_id
      render 'sunrise-find-variant', product: fp, value: section.settings.single_option_value
    endcapture
    assign single_num = single_id | strip | plus: 0
    assign single_variant = fp.selected_or_first_available_variant
    for v in fp.variants
      if v.id == single_num
        assign single_variant = v
        break
      endif
    endfor

    assign price = single_variant.price
    assign compare = 0
    assign badge = ''
    if single_variant.compare_at_price > price
      assign compare = single_variant.compare_at_price
      assign pct = compare | minus: price | times: 100 | divided_by: compare
      assign badge = section.settings.save_badge_text | replace: '[percent]', pct
    endif

    assign bundle_line = ''
    if section.settings.bundle_option_value != blank
      capture bundle_id
        render 'sunrise-find-variant', product: fp, value: section.settings.bundle_option_value
      endcapture
      assign bundle_num = bundle_id | strip | plus: 0
      for v in fp.variants
        if v.id == bundle_num and v.id != single_variant.id
          assign bundle_units = section.settings.bundle_units
          assign bundle_price = v.price | money
          assign per_unit = v.price | times: 1.0 | divided_by: bundle_units | round | money
          assign bundle_line = section.settings.bundle_text | replace: '[bundle_price]', bundle_price | replace: '[per_unit]', per_unit
          break
        endif
      endfor
    endif

    assign feature_image = section.settings.image
    if feature_image == blank
      assign feature_image = fp.featured_media.preview_image
    endif
  endif
-%}

{%- if fp -%}
  <section
    class="sr-section"
    style="--sr-pad-top: {{ section.settings.padding_top }}px; --sr-pad-bottom: {{ section.settings.padding_bottom }}px; --sr-pad-top-mobile: {{ section.settings.padding_top | times: 0.6 | round }}px; --sr-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.6 | round }}px;"
  >
    <div class="page-width sr-feature{% if section.settings.media_position == 'right' %} sr-feature--media-right{% endif %}">
      <div class="sr-feature__media">
        <a class="sr-media" href="{{ fp.url }}" tabindex="-1" aria-hidden="true">
          {%- if feature_image != blank -%}
            {{
              feature_image | image_url: width: 1200 | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: fp.title
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      </div>

      <div class="sr-feature__info">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sr-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="sr-title">
          <a href="{{ fp.url }}" class="sr-feature__title-link">{{ fp.title | escape }}</a>
        </h2>
        {%- if section.settings.show_rating -%}
          {%- render 'sunrise-rating', product: fp -%}
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="sr-feature__desc sr-body sr-rte">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="sr-checklist" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'sunrise-icon', icon: 'check' %}
                {{ block.settings.text | escape }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="sr-price sr-feature__price">
          <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
          <span class="sr-price__current">{{ price | money }}</span>
          {%- if compare > 0 -%}
            <s class="sr-price__compare">
              <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
              {{- compare | money -}}
            </s>
          {%- endif -%}
          {%- if badge != blank -%}
            <span class="sr-badge">{{ badge }}</span>
          {%- endif -%}
        </div>
        {%- if bundle_line != blank -%}
          <p class="sr-price__note sr-feature__bundle">{{ bundle_line }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="sr-feature__cta">
            <a class="sr-btn sr-btn--primary" href="{{ fp.url }}">{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width sr-section">
    <p class="sr-editor-note">Choose a product for this section.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Sunrise product showcase",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "feature",
      "name": "Key benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Gradual sunrise lighting"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Defaults to the first product in your store."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Defaults to the product's featured image."
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Meet the clock"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "info": "Appears only when a review app has added ratings to the product.",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "text",
      "id": "single_option_value",
      "label": "Single variant option value",
      "info": "Variant whose price is shown, e.g. \"1 Clock\". Leave blank for the default variant.",
      "default": "1 Clock"
    },
    {
      "type": "text",
      "id": "save_badge_text",
      "label": "Saving badge",
      "default": "Save [percent]%"
    },
    {
      "type": "text",
      "id": "bundle_option_value",
      "label": "Bundle variant option value",
      "default": "2 Clocks"
    },
    {
      "type": "range",
      "id": "bundle_units",
      "label": "Clocks in the bundle",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "bundle_text",
      "label": "Bundle text",
      "info": "Shown when the bundle variant exists. Use [bundle_price] and [per_unit].",
      "default": "Or 2 for [bundle_price] — [per_unit] per clock"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Sunrise product showcase",
      "blocks": [
        { "type": "feature", "settings": { "text": "Gradual sunrise lighting" } },
        { "type": "feature", "settings": { "text": "Modern bedside design" } },
        { "type": "feature", "settings": { "text": "Clear white digital display" } }
      ]
    }
  ]
}
{% endschema %}

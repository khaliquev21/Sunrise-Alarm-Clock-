{%- liquid
  assign detail_image = section.settings.image
  if detail_image == blank and section.settings.media_index > 0
    assign media_position = section.settings.media_index | minus: 1
    assign detail_image = product.media[media_position].preview_image
  endif
-%}
<section
  class="sr-section"
  style="--sr-pad-top: {{ section.settings.padding_top }}px; --sr-pad-bottom: {{ section.settings.padding_bottom }}px; --sr-pad-top-mobile: {{ section.settings.padding_top | times: 0.6 | round }}px; --sr-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.6 | round }}px;"
>
  <div class="page-width sr-details">
    <div class="sr-details__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="sr-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="sr-small sr-details__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if detail_image != blank -%}
        <div class="sr-media sr-details__media" style="aspect-ratio: {{ section.settings.image_ratio }};">
          {{
            detail_image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 45vw, 100vw'
          }}
        </div>
      {%- endif -%}
    </div>

    <div class="sr-details__list">
      {%- for block in section.blocks -%}
        {%- capture content -%}
          {%- case block.settings.source -%}
            {%- when 'description' -%}
              {{ product.description }}
            {%- when 'shipping_policy' -%}
              {{ shop.shipping_policy.body }}
            {%- when 'refund_policy' -%}
              {{ shop.refund_policy.body }}
            {%- when 'page' -%}
              {{ block.settings.page.content }}
            {%- else -%}
              {{ block.settings.content }}
          {%- endcase -%}
        {%- endcapture -%}
        {%- assign content_text = content | strip_html | strip -%}
        {%- if content_text != blank -%}
          <details class="sr-accordion" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
            <summary>
              <span>{{ block.settings.heading | escape }}</span>
              {% render 'sunrise-icon', icon: 'chevron' %}
            </summary>
            <div class="sr-accordion__content sr-rte">{{ content }}</div>
          </details>
        {%- elsif request.design_mode -%}
          <div class="sr-editor-note" {{ block.shopify_attributes }}>
            "{{ block.settings.heading | escape }}" is hidden on your store because it has no content yet.
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sunrise product details",
  "tag": "div",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "accordion",
      "name": "Detail row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Specifications"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Content source",
          "options": [
            { "value": "custom", "label": "Custom text below" },
            { "value": "description", "label": "Product description" },
            { "value": "shipping_policy", "label": "Shipping policy" },
            { "value": "refund_policy", "label": "Refund policy" },
            { "value": "page", "label": "Page" }
          ],
          "default": "custom"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Custom text",
          "info": "Connect a product metafield with the dynamic source button to show different content per product. Rows with no content are hidden."
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product details"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Everything you need to know before you order."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "media_index",
      "label": "Or use product image number",
      "info": "Used when no image is chosen. Set to 0 to show no image.",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Sunrise product details",
      "blocks": [
        {
          "type": "accordion",
          "settings": { "heading": "Features & functions", "open": true }
        },
        {
          "type": "accordion",
          "settings": { "heading": "Specifications" }
        },
        {
          "type": "accordion",
          "settings": { "heading": "What's included" }
        },
        {
          "type": "accordion",
          "settings": { "heading": "Shipping information", "source": "shipping_policy" }
        },
        {
          "type": "accordion",
          "settings": { "heading": "Returns & refunds", "source": "refund_policy" }
        }
      ]
    }
  ]
}
{% endschema %}
